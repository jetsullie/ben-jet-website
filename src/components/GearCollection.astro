---
import DisclosureIcon from './common/DisclosureIcon.astro';
---
<div class="gear-browser">
  <div class="gear-tools" aria-label="Browse gear" inert>
    <button type="button" id="gear-filter-toggle" aria-expanded="false" aria-controls="gear-filters"><svg class="gear-tool-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 8h22M5 16h22M5 24h22"/><path d="M11 5v6M22 13v6M14 21v6"/></svg><span class="gear-tool-label">Filter</span></button>
    <button type="button" id="gear-search-toggle" aria-expanded="false" aria-controls="gear-search-box"><svg class="gear-tool-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="14" cy="14" r="9"/><path d="m21 21 7 7"/></svg><span class="gear-tool-label">Search</span></button>
  </div>
  <details class="gear-disclosure" id="gear" data-disclosure>
    <summary class="gear-trigger"><span class="gear-trigger-copy"><strong>OUR GEAR</strong></span><span class="round-arrow" aria-hidden="true"><DisclosureIcon /></span></summary>
    <div class="gear-collection gear-showcase">
      <div class="gear-browse-controls">
        <div class="gear-panel-reveal" data-open="false"><div id="gear-filters" class="gear-filters" inert role="group" aria-label="Filter by owner">
          <button type="button" data-owner="" aria-pressed="true">All gear</button>
          <button type="button" data-owner="Jet Sullivan" aria-pressed="false">Jet’s gear</button>
          <button type="button" data-owner="Ben Stapleton" aria-pressed="false">Ben’s gear</button>
          <small>Shared items appear in both collections.</small>
        </div>
        </div><div class="gear-panel-reveal" data-open="false"><div id="gear-search-box" class="gear-search-box" inert><label for="gear-search">Find your gear</label><input type="search" id="gear-search" placeholder="Search gear or categories…" autocomplete="off" /></div></div>
        <div class="gear-results-heading"><p>Explore the tools behind our films.</p><span id="gear-result-count" role="status"></span><button type="button" id="gear-clear" hidden>Clear filters</button></div>
      </div>
      <div id="gear-results" class="gear-results"><p class="gear-empty">Loading our collection…</p></div>
    </div>
  </details>
</div>
<dialog id="gear-detail" class="gear-detail" aria-labelledby="gear-detail-title">
  <button type="button" class="gear-detail-close" aria-label="Close gear details" autofocus>Close <span aria-hidden="true">×</span></button>
  <div class="gear-detail-layout"><div class="gear-detail-image"></div><div class="gear-detail-copy"><p class="eyebrow" id="gear-detail-category"></p><h2 id="gear-detail-title"></h2><dl class="gear-detail-facts"></dl><h3>About this gear</h3><p class="gear-detail-description"></p><section class="gear-detail-kit"><h3>What’s included</h3><ul></ul></section></div></div>
</dialog>
<script>
  import '../scripts/gear-public';
</script>
