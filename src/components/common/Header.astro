---
import Plus from './Plus.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Jet Sullivan and Ben Stapleton home">JET <span>×</span> BEN<span class="wordmark-caption">SULLIVAN & STAPLETON</span></a>
  <nav aria-label="Main navigation">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    <a href="/#gear">Our gear</a>
    <a class="nav-contact" href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Let’s talk <Plus /></a>
  </nav>
</header>
