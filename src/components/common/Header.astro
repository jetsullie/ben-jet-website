---
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Jet Sullivan and Ben Stapleton home">JET <span>×</span> BEN<span class="wordmark-caption">SULLIVAN & STAPLETON</span></a>
  <nav aria-label="Main navigation">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    <a class="nav-work" href="/previous-work/" aria-current={path.startsWith('/previous-work') ? 'page' : undefined}>Previous Work</a>
    <a class="nav-contact contact-cta" href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Let’s talk <Arrow /></a>
  </nav>
</header>
