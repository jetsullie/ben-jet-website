<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.glass-shapes')).map(element => ({
    element, section: element.parentElement!, fixed: element.parentElement!.classList.contains('admin-main'), top: 0, height: 0, current: 0,
  }));
  // Animate coherent groups once, never stack transforms on nested text/buttons.
  const candidates = Array.from(document.querySelectorAll<HTMLElement>([
    '.site-header .wordmark', '.site-header nav', '.hero-topline', '.split-title',
    '.story-tabs', '.hero-bottom > p', '.services', '.team-section', '.gear-section',
    '.closing', '.contact-hero > .eyebrow', '.contact-hero > h1', '.contact-hero > .intro-copy',
    '.contact-grid', '.contact-note', '.work-intro', '.work-collections',
    '.about-content', '.about-admin', '.team-footer > *', '.admin-header', '.work-admin', '.admin-panel', '.settings-admin',
  ].join(',')));
  const groups = candidates.filter(element => !candidates.some(parent => parent !== element && parent.contains(element)))
    .map(element => {
      element.dataset.parallaxGroup = '';
      const navigation = Boolean(element.closest('.site-header'));
      const title = element.matches('.split-title, .hero-topline, .work-intro, .admin-header, .contact-hero > h1');
      return { element, anchor: element.querySelector<HTMLElement>('.gear-trigger') || element,
        limit: navigation ? 5 : title ? 28 : 20,
        speed: navigation ? .012 : title ? .055 : .04,
        pointer: navigation ? .15 : title ? .5 : .32,
        top: 0, height: 0, x: 0, y: 0 };
    });
  let divideCenter = 0;
  const hero = document.querySelector<HTMLElement>('.split-hero');
  const cross = document.querySelector<HTMLElement>('.team-name b');
  let frame = 0;
  let lastTime = 0;
  let pointerX = 0, pointerY = 0, currentX = 0, currentY = 0;
  const clamp = (n: number, limit: number) => Math.max(-limit, Math.min(limit, n));

  const measure = () => {
    for (const layer of layers) {
      const rect = layer.section.getBoundingClientRect();
      layer.top = rect.top + scrollY;
      layer.height = rect.height;
    }
    for (const group of groups) {
      const rect = group.anchor.getBoundingClientRect();
      group.top = rect.top + scrollY - group.y;
      group.height = rect.height;
    }
    if (hero && cross) {
      const bounds = hero.getBoundingClientRect();
      const mark = cross.getBoundingClientRect();
      hero.style.setProperty('--divide-height', `${bounds.height}px`);
      const titleShift = groups.find(group => group.element.classList.contains('split-title'))?.y || 0;
      divideCenter = mark.top + mark.height / 2 - bounds.top - titleShift;
      hero.style.setProperty('--divide-y', `${divideCenter + titleShift}px`);
    }
    schedule();
  };
  function tick(time: number) {
    frame = 0;
    const amount = 1 - Math.exp(-Math.min(time - (lastTime || time - 16), 50) / 190);
    lastTime = time;
    const disabled = reduced.matches;
    const modalOpen = Boolean(document.querySelector('dialog[open]'));
    if (modalOpen && !disabled) { lastTime = 0; return; }
    currentX += ((disabled ? 0 : pointerX) - currentX) * amount;
    currentY += ((disabled ? 0 : pointerY) - currentY) * amount;
    let unsettled = Math.abs(currentX - pointerX) + Math.abs(currentY - pointerY) > .01 && !disabled;
    for (const layer of layers) {
      // Stable document coordinates avoid feedback from the animated shapes.
      const distance = scrollY + innerHeight / 2 - (layer.top + layer.height / 2);
      const target = disabled ? 0 : layer.fixed
        ? Math.sin(scrollY / Math.max(innerHeight * 1.5, 1)) * 80
        : clamp(distance * (finePointer.matches ? .18 : .12), finePointer.matches ? 110 : 72);
      layer.current = disabled ? 0 : layer.current + (target - layer.current) * amount;
      if (Math.abs(target - layer.current) > .025) unsettled = true;
      layer.element.style.setProperty('--glass-scroll', `${layer.current.toFixed(2)}px`);
      layer.element.style.setProperty('--glass-x', `${currentX.toFixed(2)}px`);
      layer.element.style.setProperty('--glass-y', `${currentY.toFixed(2)}px`);

    }
    const hoveredControl = finePointer.matches ? document.querySelector<HTMLElement>('a:hover, button:hover, input:hover, textarea:hover, select:hover, summary:hover, [contenteditable=true]:hover') : null;
    for (const group of groups) {
      const nearViewport = group.top < scrollY + innerHeight + 120 && group.top + group.height > scrollY - 120;
      if (!nearViewport && !disabled) continue;
      // Hold controls steady while visitors click, type, or use the keyboard.
      const interacting = group.element.matches(':focus-within') || Boolean(hoveredControl && group.element.contains(hoveredControl));
      const distance = scrollY + innerHeight / 2 - (group.top + group.height / 2);
      const strength = finePointer.matches ? 1 : .6;
      const targetY = disabled ? 0 : interacting ? group.y : (clamp(-distance * group.speed, group.limit) + currentY * group.pointer) * strength;
      const targetX = disabled ? 0 : interacting ? group.x : currentX * group.pointer;
      group.y = disabled ? 0 : group.y + (targetY - group.y) * amount;
      group.x = disabled ? 0 : group.x + (targetX - group.x) * amount;
      if (Math.abs(targetY - group.y) + Math.abs(targetX - group.x) > .025) unsettled = true;
      group.element.style.setProperty('--glass-light-x', `${(50 + (disabled ? 0 : currentX * 3)).toFixed(2)}%`);
      group.element.style.setProperty('--glass-light-y', `${(30 + (disabled ? 0 : currentY * 3)).toFixed(2)}%`);
      group.element.style.setProperty('--parallax-x', `${group.x.toFixed(2)}px`);
      group.element.style.setProperty('--parallax-y', `${group.y.toFixed(2)}px`);
      if (hero && group.element.classList.contains('split-title')) {
        hero.style.setProperty('--divide-y', `${divideCenter + group.y}px`);
        hero.style.setProperty('--divide-x', `${group.x}px`);
      }
    }
    if (unsettled) frame = requestAnimationFrame(tick);
    else lastTime = 0;
  }
  function schedule() {
    if (!frame && !document.hidden) frame = requestAnimationFrame(tick);
  }
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', measure, { passive: true });
  addEventListener('pointermove', event => {
    if (!finePointer.matches || reduced.matches) return;
    pointerX = (event.clientX / innerWidth - .5) * 24;
    pointerY = (event.clientY / innerHeight - .5) * 18;
    schedule();
  }, { passive: true });
  document.addEventListener('close', schedule, true);
  document.addEventListener('focusin', schedule);
  document.addEventListener('focusout', schedule);
  document.documentElement.addEventListener('mouseleave', () => { pointerX = pointerY = 0; schedule(); });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { cancelAnimationFrame(frame); frame = 0; lastTime = 0; }
    else measure();
  });
  reduced.addEventListener('change', () => { pointerX = pointerY = 0; measure(); });
  finePointer.addEventListener('change', () => { pointerX = pointerY = 0; schedule(); });
  const observer = new ResizeObserver(measure);
  layers.forEach(layer => observer.observe(layer.section));
  groups.forEach(group => observer.observe(group.element));
  observer.observe(document.body);
  if (cross) observer.observe(cross);
  void document.fonts.ready.then(measure);
  measure();
</script>
