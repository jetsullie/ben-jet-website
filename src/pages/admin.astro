---
import PageMotion from '../components/common/PageMotion.astro';
import SiteSettingsAdmin from '../components/SiteSettingsAdmin.astro';
import AboutAdmin from '../components/AboutAdmin.astro';
import WorkAdmin from '../components/WorkAdmin.astro';
import GlassShapes from '../components/common/GlassShapes.astro';
import Arrow from '../components/common/Arrow.astro';
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow,noarchive" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>Site Admin — Jet × Ben</title></head>
<body class="admin-body">
  <main class="admin-main"><GlassShapes tone="mint" />
    <header class="admin-header"><div><p class="eyebrow">PRIVATE OWNER DASHBOARD</p><h1>Site admin.</h1><p>Publish previous work and manage the shared gear collection.</p></div><div class="admin-header-actions"><a href="/">View website <Arrow /></a><a href="/cdn-cgi/access/logout">Sign out</a></div></header>

    <SiteSettingsAdmin />
    <AboutAdmin />
    <WorkAdmin />
    <section class="admin-panel gear-admin-panel" aria-labelledby="gear-editor-title">
      <div class="admin-panel-heading"><span>01</span><div><p class="eyebrow">COLLECTION EDITOR</p><h2 id="gear-editor-title">Add gear</h2><p>Add a piece of kit, choose its owner, and tell visitors what makes it useful.</p></div></div>
      <form id="gear-form" enctype="multipart/form-data">
        <input id="gear-id" name="id" type="hidden" />
        <fieldset class="gear-form-group"><legend>01 / The basics</legend><div class="admin-fields">
          <label class="wide"><span>Gear name</span><input id="gear-name" name="name" type="text" maxlength="120" required /></label>
          <label><span>Category</span><input id="gear-category" name="category" type="text" maxlength="80" placeholder="Choose or type a category" list="gear-category-options" required /></label>
          <label><span>Owned by</span><select id="gear-owner" name="owner"><option value="">Not specified</option><option value="Jet Sullivan">Jet Sullivan</option><option value="Ben Stapleton">Ben Stapleton</option><option value="Jet Sullivan & Ben Stapleton">Both / Shared</option></select></label>
          <label><span>Current condition out of 5</span><input id="gear-rating" name="rating" type="number" min="0.5" max="5" step="0.5" value="5" required /></label>
          </div></fieldset><fieldset class="gear-form-group"><legend>02 / Product photo</legend><div class="admin-fields"><label><span>Product photo</span><input id="gear-image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" required /><small id="gear-image-current">JPEG, PNG, WebP, or AVIF. Maximum 15 MB.</small></label>
          <label><span>Photo description</span><input id="gear-image-alt" name="imageAlt" type="text" maxlength="180" placeholder="Describe the product photo" /></label>
          </div></fieldset><fieldset class="gear-form-group"><legend>03 / The details</legend><div class="admin-fields"><label class="wide"><span>Description</span><textarea id="gear-description" placeholder="What is it, and how do you use it?" name="description" maxlength="20000" required></textarea></label>
          <label class="wide"><span>What’s included (optional)</span><textarea id="gear-kit-parts" name="kitParts" placeholder="One part per line"></textarea><small>Blank lines are ignored.</small></label>
        </div>
        </fieldset><datalist id="gear-category-options"><option>Audio</option><option>Camera</option><option>Drone</option><option>Gimbal</option><option>Lens</option><option>Lighting</option></datalist>
        <div class="admin-actions"><button id="gear-submit" type="submit">Add gear <Arrow /></button><button id="gear-cancel" class="secondary" type="button" hidden>Cancel edit</button><output id="gear-status" aria-live="polite"></output></div>
      </form>
    </section>

    <section class="admin-panel gear-admin-panel" aria-labelledby="listed-gear-title"><div class="admin-panel-heading"><span>02</span><div><p class="eyebrow">CURRENT INVENTORY</p><h2 id="listed-gear-title">Your collection</h2><p>Review, edit, or remove the gear shown on the website.</p></div></div><div class="gear-admin-filters"><label>Search collection<input type="search" id="admin-gear-search" placeholder="Gear name or category…" /></label><label>Owner<select id="admin-gear-owner"><option value="">All gear</option><option value="Jet Sullivan">Jet’s gear (including shared)</option><option value="Ben Stapleton">Ben’s gear (including shared)</option></select></label><span id="admin-gear-count" role="status"></span></div><div id="gear-list" class="admin-gear-list"><p>Loading gear…</p></div></section>
  </main>

  <dialog id="gear-delete-dialog" aria-labelledby="gear-delete-title"><form method="dialog"><p class="eyebrow">CONFIRM DELETION</p><h2 id="gear-delete-title">Delete this gear item?</h2><p id="gear-delete-message"></p><div class="admin-actions"><button class="secondary" value="cancel">Keep gear</button><button id="gear-delete-submit" class="danger" value="confirm">Delete gear</button></div></form></dialog>
<PageMotion /></body>
</html>

<script>
  type GearItem = { id:string; name:string; category:string; owner?:string; rating:number; description:string; kitParts:string[]; imageUrl?:string|null; imageAlt?:string|null };
  const form=document.querySelector<HTMLFormElement>('#gear-form')!;
  const fields={owner:document.querySelector<HTMLSelectElement>('#gear-owner')!,id:document.querySelector<HTMLInputElement>('#gear-id')!,name:document.querySelector<HTMLInputElement>('#gear-name')!,category:document.querySelector<HTMLInputElement>('#gear-category')!,rating:document.querySelector<HTMLInputElement>('#gear-rating')!,image:document.querySelector<HTMLInputElement>('#gear-image')!,imageAlt:document.querySelector<HTMLInputElement>('#gear-image-alt')!,description:document.querySelector<HTMLTextAreaElement>('#gear-description')!,parts:document.querySelector<HTMLTextAreaElement>('#gear-kit-parts')!};
  const submit=document.querySelector<HTMLButtonElement>('#gear-submit')!; const cancel=document.querySelector<HTMLButtonElement>('#gear-cancel')!; const status=document.querySelector<HTMLOutputElement>('#gear-status')!; const list=document.querySelector<HTMLElement>('#gear-list')!; const imageHelp=document.querySelector<HTMLElement>('#gear-image-current')!; const dialog=document.querySelector<HTMLDialogElement>('#gear-delete-dialog')!; const deleteMessage=document.querySelector<HTMLElement>('#gear-delete-message')!; const deleteSubmit=document.querySelector<HTMLButtonElement>('#gear-delete-submit')!; let pending:GearItem|null=null;
  const errorText=async(response:Response)=>{try{const body=await response.json();if(body.error)return body.error}catch{}return response.status===404?'Admin API unavailable in Astro dev. Deploy with Cloudflare Pages Functions to manage live gear.':`Request failed with HTTP ${response.status}.`};
  const editorTitle=document.querySelector<HTMLElement>('#gear-editor-title')!;
  const inventorySearch=document.querySelector<HTMLInputElement>('#admin-gear-search')!;
  const inventoryOwner=document.querySelector<HTMLSelectElement>('#admin-gear-owner')!;
  let inventory:GearItem[]=[];
  const reset=()=>{editorTitle.textContent='Add gear';form.reset();fields.id.value='';fields.rating.value='5';fields.image.required=true;imageHelp.textContent='JPEG, PNG, WebP, or AVIF. Maximum 15 MB.';submit.textContent='Add gear';cancel.hidden=true};
  const edit=(item:GearItem)=>{editorTitle.textContent='Edit gear';fields.image.value='';fields.id.value=item.id;fields.name.value=item.name;fields.category.value=item.category;fields.owner.value=item.owner||'';fields.rating.value=String(item.rating);fields.imageAlt.value=item.imageAlt||'';fields.description.value=item.description;fields.parts.value=item.kitParts?.join('\n')||'';fields.image.required=!item.imageUrl;imageHelp.textContent=item.imageUrl?'The current photo remains unless you choose a replacement.':'Choose a product photo.';submit.textContent='Update gear';cancel.hidden=false;status.textContent=`Editing “${item.name}”.`;form.scrollIntoView({behavior:'smooth'});fields.name.focus({preventScroll:true})};
  const render = (allItems: GearItem[]) => {
    inventory = allItems;
    const query = inventorySearch.value.trim().toLowerCase();
    const items = allItems.filter(item => (!inventoryOwner.value || item.owner?.includes(inventoryOwner.value)) && `${item.name} ${item.category}`.toLowerCase().includes(query));
    document.querySelector('#admin-gear-count')!.textContent = `${items.length} of ${allItems.length} items`;
    list.replaceChildren();
    if (!items.length) {
      const empty = document.createElement('p');
      empty.textContent = allItems.length ? 'No matching gear. Try another search or owner.' : 'Your collection is empty. Add your first piece of gear above.';
      list.append(empty);
      return;
    }
    for (const item of items) {
      const card = document.createElement('article'); card.className = 'admin-gear-card';
      const photo = document.createElement('div'); photo.className = 'inventory-photo';
      if (item.imageUrl) {
        const img = document.createElement('img'); img.src = item.imageUrl; img.alt = item.imageAlt || item.name; img.loading = 'lazy'; photo.append(img);
      } else { photo.textContent = 'No photo'; }
      const copy = document.createElement('div'); copy.className = 'inventory-copy';
      const category = document.createElement('p'); category.className = 'eyebrow'; category.textContent = item.category;
      const title = document.createElement('h3'); title.textContent = item.name;
      const meta = document.createElement('dl'); meta.className = 'inventory-facts';
      for (const [label, value] of [['Owner', item.owner || 'Not specified'], ['Condition', `${Number(item.rating).toFixed(1)} / 5`], ['Kit contents', `${item.kitParts?.length || 0} parts`]]) {
        const group = document.createElement('div'); const term = document.createElement('dt'); const detail = document.createElement('dd');
        term.textContent = label; detail.textContent = value; group.append(term, detail); meta.append(group);
      }
      const description = document.createElement('p'); description.className = 'gear-admin-excerpt'; description.textContent = item.description;
      const actions = document.createElement('div'); actions.className = 'inventory-actions';
      const editButton = document.createElement('button'); editButton.type = 'button'; editButton.className = 'inventory-edit'; editButton.textContent = 'Edit gear'; editButton.setAttribute('aria-label', `Edit ${item.name}`); editButton.onclick = () => edit(item);
      const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'inventory-delete'; remove.textContent = 'Delete'; remove.setAttribute('aria-label', `Delete ${item.name}`);
      remove.onclick = () => { pending = item; deleteMessage.textContent = `“${item.name}” will be removed from the public collection.`; dialog.showModal(); };
      actions.append(editButton, remove); copy.append(category, title, meta, description); card.append(photo, copy, actions); list.append(card);
    }
  };
  const load=async(message='')=>{status.textContent='Loading gear…';try{const response=await fetch('/admin/api/gear',{credentials:'same-origin'});if(!response.ok)throw new Error(await errorText(response));const result=await response.json();render(Array.isArray(result.items)?result.items:[]);status.textContent=message}catch(error){status.textContent=error instanceof Error?error.message:'Could not load gear.';list.textContent='The collection could not be loaded. Refresh to try again.'}};
  inventorySearch.addEventListener('input',()=>render(inventory));
  inventoryOwner.addEventListener('change',()=>render(inventory));
  cancel.onclick=()=>{reset();status.textContent='Edit cancelled.'};
  form.onsubmit=async(event)=>{event.preventDefault();const editing=Boolean(fields.id.value);status.textContent=editing?'Updating gear…':'Adding gear…';submit.disabled=true;cancel.disabled=true;try{const response=await fetch('/admin/api/gear',{method:editing?'PUT':'POST',credentials:'same-origin',body:new FormData(form)});if(!response.ok)throw new Error(await errorText(response));reset();await load(editing?'Gear updated.':'Gear added.')}catch(error){status.textContent=error instanceof Error?error.message:'Could not save gear.'}finally{submit.disabled=false;cancel.disabled=false}};
  dialog.addEventListener('close',async()=>{if(dialog.returnValue!=='confirm'||!pending)return;const item=pending;pending=null;deleteSubmit.disabled=true;status.textContent=`Deleting “${item.name}”…`;try{const response=await fetch(`/admin/api/gear?id=${encodeURIComponent(item.id)}`,{method:'DELETE',credentials:'same-origin'});if(!response.ok)throw new Error(await errorText(response));if(fields.id.value===item.id)reset();await load('Gear deleted.')}catch(error){status.textContent=error instanceof Error?error.message:'Could not delete gear.'}finally{deleteSubmit.disabled=false}});
  reset(); void load();
</script>

<style>
  .admin-body{background:var(--black);color:var(--white)}.admin-main{width:min(1180px,90%);margin:auto;padding:60px 0 100px}.admin-header{display:flex;justify-content:space-between;gap:50px;align-items:flex-end;margin-bottom:55px}.admin-header h1{margin:10px 0;font-size:clamp(3.5rem,9vw,8rem)}.admin-header>div>p:last-child{color:#ccc}.admin-header-actions{display:flex;gap:12px;flex-wrap:wrap}.admin-header-actions a{display:flex;align-items:center;gap:12px;padding:13px 18px;border:2px solid var(--white);border-radius:999px;font-weight:800}.admin-panel{margin-top:28px;padding:clamp(25px,4vw,48px);border:1px solid #ffffff30;border-radius:0;background:var(--black);box-shadow:none}.admin-panel-heading{display:flex;gap:25px;align-items:flex-start;margin-bottom:35px}.admin-panel-heading>span{padding-top:9px;font-weight:900}.admin-panel-heading h2{margin:5px 0 0;font-size:clamp(2.4rem,5vw,4.5rem)}.admin-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.admin-fields label{display:grid;gap:9px;font-weight:800}.admin-fields label>span{font-size:12px;letter-spacing:.08em;text-transform:uppercase}.admin-fields .wide{grid-column:1/-1}.admin-fields input,.admin-fields select,.admin-fields textarea{width:100%;padding:15px;border:3px solid var(--white);border-radius:12px;background:var(--gray);color:var(--white);font:inherit}.admin-fields textarea{min-height:140px;resize:vertical}.admin-fields small{color:#aaa}.admin-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:24px}.admin-actions button,.admin-actions a{display:inline-flex;align-items:center;gap:15px;padding:13px 18px;border:3px solid var(--white);border-radius:999px;background:var(--yellow);color:var(--black);font:800 .85rem var(--body);cursor:pointer}.admin-actions .secondary{background:var(--white)}.admin-actions .danger{background:#f55c66}.admin-actions output{color:inherit;font-weight:800}.admin-gear-list{display:grid;gap:18px}.admin-gear-card{display:grid;grid-template-columns:190px 1fr;gap:25px;padding:18px;border:3px solid var(--white);border-radius:18px;background:var(--gray)}.admin-gear-card img{width:190px;height:190px;object-fit:contain;background:var(--white);padding:12px;border-radius:12px}.admin-gear-card h3{margin:7px 0 10px}.admin-gear-card p{color:#ddd;white-space:pre-line}.admin-gear-card .eyebrow{color:inherit}dialog{max-width:540px;padding:35px;border:6px solid var(--black);border-radius:22px;box-shadow:12px 12px 0 var(--black)}dialog::backdrop{background:#252525cc}@media(max-width:700px){.admin-header{align-items:flex-start;flex-direction:column}.admin-fields{grid-template-columns:1fr}.admin-fields .wide{grid-column:auto}.admin-gear-card{grid-template-columns:1fr}.admin-gear-card img{width:100%;height:220px}}

  .admin-header-actions a,.admin-actions button,.admin-actions .secondary,.admin-actions .danger{border:1px solid #ffffff94;background:rgb(255 255 255 / 86%);color:var(--black);outline:1px solid #ffffff29;outline-offset:-3px;box-shadow:0 8px 28px #25252524;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background-color 180ms ease,box-shadow 220ms ease,transform 280ms cubic-bezier(.34,1.4,.64,1)}
  .admin-actions .danger{background:#fdbfbf}
  .admin-header-actions a:hover,.admin-actions button:hover{background:var(--white);color:var(--black);transform:translateY(-3px);box-shadow:0 8px 28px #25252524,0 0 18px #ffffff61}
  .admin-actions button[hidden]{display:none}
  dialog{background:var(--white);color:var(--black)}
</style>

<style is:global>
.gear-admin-panel{border-radius:22px!important;border-color:#ffffff26!important;background:linear-gradient(135deg,#ffffff06,#93e9f905)!important}.gear-admin-panel .admin-panel-heading h2{font-size:clamp(2rem,3vw,3rem)}.gear-admin-panel .admin-panel-heading p:last-child{max-width:560px;color:#bbb;margin:14px 0 0;font-size:15px}.gear-form-group{border:0;border-top:1px solid #ffffff24;padding:26px 0 0;margin:0 0 30px;min-width:0}.gear-form-group legend{padding:0 14px 0 0;color:var(--blue);font-size:12px;font-weight:800;letter-spacing:.06em}.gear-admin-panel #gear-form .admin-fields input,.gear-admin-panel #gear-form .admin-fields select,.gear-admin-panel #gear-form .admin-fields textarea,.gear-admin-filters input,.gear-admin-filters select{border:1px solid #ffffff40;border-radius:10px;background:#ffffff08;color:white;padding:13px;font:inherit;width:100%;color-scheme:dark}.gear-admin-panel .admin-fields textarea{min-height:120px}.gear-admin-panel .admin-fields small{font-weight:400;line-height:1.5}.gear-admin-panel #gear-submit{background:var(--blue)}.gear-admin-filters{display:grid;grid-template-columns:1fr 1fr auto;align-items:end;gap:18px;margin-bottom:24px}.gear-admin-filters label{display:grid;gap:8px;font-size:13px}.gear-admin-filters>span{font-size:12px;padding-bottom:14px;color:#bbb}.gear-admin-panel .admin-gear-card{grid-template-columns:100px minmax(0,1fr);padding:20px;gap:22px;border:1px solid #ffffff26;border-radius:16px;background:#ffffff05}.gear-admin-panel .admin-gear-card img{width:100px;height:100px;border-radius:10px}.gear-admin-panel .admin-gear-card>div:only-child{grid-column:1/-1}.gear-admin-panel .admin-gear-card h3{font-size:1.3rem;overflow-wrap:anywhere}.gear-admin-panel .admin-gear-card p{font-size:13px;margin-bottom:10px}.gear-admin-excerpt{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.gear-admin-panel .admin-actions{margin-top:16px}.gear-admin-panel .admin-actions button{min-height:44px}.gear-admin-panel .admin-gear-card .eyebrow{color:var(--blue)}
@media(max-width:600px){.gear-admin-filters{grid-template-columns:1fr}.gear-admin-filters>span{padding:0}.gear-admin-panel .admin-gear-card{grid-template-columns:1fr}.gear-admin-panel .admin-gear-card img{width:80px;height:80px}}
</style>

<style is:global>
#gear-list{gap:14px}
#gear-list .admin-gear-card{display:grid;grid-template-columns:88px minmax(0,1fr) 112px;align-items:start;gap:24px;padding:24px;background:#ffffff04;border:1px solid #ffffff20;border-radius:18px}
#gear-list .inventory-photo{display:grid;place-items:center;width:88px;height:88px;border-radius:12px;background:white;color:#666;font-size:12px;overflow:hidden}
#gear-list .inventory-photo img{width:100%;height:100%;object-fit:contain;padding:8px;border-radius:0}
#gear-list .inventory-copy{min-width:0}
#gear-list .inventory-copy .eyebrow{font-size:10px;letter-spacing:.1em;margin:0 0 8px;color:var(--blue)}
#gear-list h3{font-size:1.25rem;line-height:1.3;letter-spacing:-.025em;margin:0 0 18px;overflow-wrap:anywhere}
#gear-list .inventory-facts{display:grid;grid-template-columns:minmax(130px,1.5fr) 1fr 1fr;gap:16px;margin:0 0 16px}
#gear-list .inventory-facts dt{color:#aaa;font-size:11px;margin-bottom:5px}
#gear-list .inventory-facts dd{margin:0;font-size:13px;line-height:1.5;color:#f4f4f4;overflow-wrap:anywhere}
#gear-list .gear-admin-excerpt{margin:0;font-size:13px;line-height:1.6;color:#aaa;white-space:normal;overflow-wrap:anywhere}
#gear-list .inventory-actions{display:flex;flex-direction:column;gap:8px}
#gear-list .inventory-actions button{display:flex;align-items:center;justify-content:center;min-height:44px;padding:11px 16px;border:1px solid #ffffff30;border-radius:10px;background:#ffffff08;color:white;font:700 13px var(--body);cursor:pointer;transition:background-color 180ms ease,border-color 180ms ease}
#gear-list .inventory-actions .inventory-edit{background:#93e9f918;border-color:#93e9f950;color:#bbf1fc}
#gear-list .inventory-actions .inventory-delete{background:transparent;border-color:transparent;color:#efb0b6}
#gear-list .inventory-edit:hover{background:#93e9f930;border-color:#93e9f980}
#gear-list .inventory-delete:hover{background:#fdbfbf12;border-color:#fdbfbf40}
@media(max-width:850px){#gear-list .admin-gear-card{grid-template-columns:72px minmax(0,1fr);gap:18px}#gear-list .inventory-photo{width:72px;height:72px}#gear-list .inventory-actions{grid-column:2;flex-direction:row;border-top:1px solid #ffffff18;padding-top:14px}#gear-list .inventory-facts{grid-template-columns:1fr 1fr}#gear-list .inventory-facts>div:first-child{grid-column:1/-1}}
@media(max-width:480px){#gear-list .admin-gear-card{padding:18px;grid-template-columns:minmax(0,1fr)}#gear-list .inventory-actions{grid-column:1}#gear-list .inventory-actions button{flex:1}}
@media(prefers-reduced-motion:reduce){#gear-list .inventory-actions button{transition:none}}
</style>
