---
import Layout from '../layouts/Layout.astro';
import Plus from '../components/common/Plus.astro';
import GearCollection from '../components/GearCollection.astro';
---
<Layout title="Two filmmakers. One shared vision." description="Jet Sullivan and Ben Stapleton. Austin, Texas filmmakers creating wedding films, corporate interviews, documentaries, and more.">
  <section class="split-hero section-shell" data-motion-bounds>
    <div class="split-side split-mono" aria-hidden="true"></div>
    <div class="split-side split-white" aria-hidden="true"></div>
    <div class="home-hero wrap">
      <div class="hero-topline" data-motion-depth="counter"><span class="eyebrow"><i class="location-dot"></i> AUSTIN, TEXAS · FILM & VIDEO</span><span class="small-label">TWO FILMMAKERS. ONE SHARED VISION.</span></div>
      <div class="split-title" data-motion-depth="scene">
        <h1 class="team-name"><span>JET</span><b>×</b><span>BEN</span></h1>
      </div>
      <nav class="story-tabs" aria-label="What we create" data-motion-depth="deep">
        <a href="#weddings" class="story-tab pink"><span>01 / WEDDINGS</span><strong>Remember</strong><Plus /></a>
        <a href="#interviews" class="story-tab blue"><span>02 / CORPORATE</span><strong>Connect</strong><Plus /></a>
        <a href="#documentaries" class="story-tab mint"><span>03 / DOCUMENTARY</span><strong>Capture</strong><Plus /></a>
      </nav>
      <div class="hero-bottom" data-motion-depth="counter"><p>We’re Jet Sullivan and Ben Stapleton. A filmmaking team capturing real people, meaningful moments, and stories worth sharing.</p><a class="button yellow" href="/contact/">Tell us your story <Plus /></a></div>
    </div>
  </section>

  <section class="services-section section-shell">
    <div class="services wrap" aria-labelledby="services-heading">
      <div class="section-intro" data-motion-depth="scene"><p class="eyebrow dark-eyebrow">WHAT WE CREATE</p><h2 id="services-heading">Your story.<br />Our full attention.</h2><p>From a once-in-a-lifetime day to an idea that deserves to be heard, we bring a thoughtful eye to every project.</p></div>
      <div class="service-list" data-motion-depth="counter">
        <article id="weddings"><span>01</span><div><h3>Wedding videography</h3><p>The big feelings and the small, in-between moments. Wedding films that bring you right back.</p></div><span class="service-mark" aria-hidden="true"><Plus /></span></article>
        <article id="interviews"><span>02</span><div><h3>Corporate interviews</h3><p>Put people at the heart of your business. Clear, personal interviews that give your team and ideas a voice.</p></div><span class="service-mark" aria-hidden="true"><Plus /></span></article>
        <article id="documentaries"><span>03</span><div><h3>Documentaries & more</h3><p>Real stories, told with curiosity and care. Have something else in mind? We’d love to hear it.</p></div><span class="service-mark" aria-hidden="true"><Plus /></span></article>
      </div>
    </div>
  </section>

  <section class="team-band section-shell">
    <div class="team-section wrap">
      <p class="eyebrow" data-motion-depth="counter">THE PEOPLE BEHIND THE CAMERA</p>
      <div class="team-copy"><h2 data-motion-depth="scene">Two perspectives.<br />One team.</h2><div data-motion-depth="deep"><p>We’re Jet and Ben, based in Austin, Texas. We work together to bring a personal approach to film and video, from the first conversation to the finished story.</p><a class="text-link" href="/contact/">Meet your next collaborators <Plus /></a></div></div>
      <GearCollection />
    </div>
  </section>

  <section class="closing-band section-shell"><div class="closing wrap" data-motion-depth="scene"><p class="eyebrow dark-eyebrow">READY WHEN YOU ARE</p><h2>Let’s talk!</h2><a class="button black-button" href="/contact/">Start a project <Plus /></a></div></section>
</Layout>
