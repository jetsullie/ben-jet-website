---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/common/Arrow.astro';
---
<Layout title="About us" description="Meet Jet Sullivan and Ben Stapleton, the filmmakers behind Jet x Ben Film and Video.">
  <section class="about-page section-shell">
    <div class="glass-shapes glass-shapes--blue about-glass" aria-hidden="true"><span class="glass-shape glass-cross"></span></div>
    <div class="wrap about-content">
      <header class="about-intro"><p class="eyebrow">THE PEOPLE BEHIND THE CAMERA</p><h1><span class="attention-ink statement-ink statement-ink--mint" data-attention>ABOUT US.</span></h1><p>Two perspectives. One shared vision.<br />Based in <span data-site-location>Austin, Texas</span>.</p></header>
      <div class="about-profiles">
        {['jet','ben'].map((person,index)=><article class:list={['about-profile',`about-profile--${person}`]} aria-labelledby={`${person}-name`}>
          <span class="eyebrow">0{index+1} / FILMMAKER</span><h2 id={`${person}-name`}>{person==='jet'?'Jet Sullivan':'Ben Stapleton'}</h2>
          <div class="biography-content" data-about-person={person}><p>Biography coming soon.</p></div>
        </article>)}
      </div>
      <div class="about-contact"><a class="button contact-cta" href="/contact/">Get in touch <Arrow /></a></div>
    </div>
  </section>
</Layout>
<script>
import {normalizeBiographyDocument,renderBiographyDocument,biographyDocumentToText} from '../lib/biography';
void fetch('/api/about').then(async response=>{
 if(!response.ok)return;const result=await response.json();
 for(const element of document.querySelectorAll<HTMLElement>('[data-about-person]')){
  const doc=normalizeBiographyDocument(result.profiles?.[element.dataset.aboutPerson!]?.document);
  if(doc&&biographyDocumentToText(doc))renderBiographyDocument(element,doc,{linksOpenInNewTab:true});
 }
}).catch(()=>{});
</script>
